{
    "name": "hausformat/hf-lib",
    "type": "typo3-cms-extension",
    "version": "2.0.1",
    "description": "Hausformat Library with TYPO3 helpers",
    "require": {
        "typo3/cms-core": "^13 || ^14",
        "typo3/cms-extbase": "*",
        "typo3/cms-frontend": "*"
    },
    "require-dev": {
        "typo3/testing-framework": "^8",
        "phpstan/phpstan": "^2",
        "typo3/coding-standards": "^0.8.0"
    },
    "autoload": {
        "psr-4": {
            "Hausformat\\Lib\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hausformat\\Lib\\Tests\\": "Tests"
        }
    },
    "license": [
        "All Rights Reserved"
    ],
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "hf_lib",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "docs": [
            "@docs:build",
            "@docs:open"
        ],
        "docs:build": "bash ./Build/Scripts/runTests.sh -s docsGenerate",
        "docs:open": "open .Build/docs/index.html",
        "test:functional": "bash ./Build/Scripts/runTests.sh -s functional",
        "phpstan": ".Build/bin/phpstan analyse -c ./phpstan.neon --memory-limit 10G",
        "ci:tests:functional": "/bin/bash ./Build/Scripts/runTests.sh -s functional -- --log-junit phpunit-report.xml",
        "ci:phpstan": ".Build/bin/phpstan analyse --error-format=gitlab --no-progress -c ./phpstan.neon > gl-code-quality-report.json"
    },
    "repositories": [
    ],
    "keywords": [
        "TYPO3 CMS"
    ]
}
