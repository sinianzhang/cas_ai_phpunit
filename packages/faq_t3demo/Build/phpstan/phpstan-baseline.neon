			message: '#^Call to method PHPUnit\\Framework\\Assert\:\:assertInstanceOf\(\) with ''Hausformat\\\\ViewHelpers\\\\Dummy\\\\ServiceInterface'' and Hausformat\\ViewHelpers\\Dummy\\Service will always evaluate to true\.$#'
