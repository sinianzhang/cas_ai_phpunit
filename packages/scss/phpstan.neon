parameters:
    phpVersion:
        min: 80200
        max: 80499
    level: 5
    treatPhpDocTypesAsCertain: false
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    editorUrlTitle: '%%relFile%%:%%line%%'
    paths:
        - Classes/

    bootstrapFiles:
        - Build/phpstan/phpstan-constants.php
