{
    "name": "hausformat/scss",
    "description": "SASS compiler for TYPO3",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "version": "3.1.1",
    "require": {
        "typo3/cms-core": "^13 || ^14",
        "typo3/cms-extbase": "*",
        "typo3/cms-frontend": "*",
        "scssphp/scssphp": "^1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "typo3/coding-standards": "^0.8.0"
    },
    "autoload": {
        "psr-4": {
            "Hausformat\\Scss\\": "Classes/"
        }
    },
    "scripts": {
        "phpstan": ".Build/bin/phpstan analyse -c ./phpstan.neon",
        "ci:phpstan": ".Build/bin/phpstan analyse --error-format=gitlab --no-progress -c ./phpstan.neon > gl-code-quality-report.json"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "scss",
            "web-dir": ".Build/Web"
        }
    }
}
