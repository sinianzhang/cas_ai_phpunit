includes:
    - ../../vendor/phpstan/phpstan-phpunit/extension.neon
    - ../../vendor/phpstan/phpstan-phpunit/rules.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - Tests/Unit/
    bootstrapFiles:
        - Build/phpstan/phpstan-constants.php
    errorFormat: table
    reportUnmatchedIgnoredErrors: false
	
