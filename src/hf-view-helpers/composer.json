{
    "name": "hausformat/hf-view-helpers",
    "type": "typo3-cms-extension",
    "version": "2.0.4",
    "description": "Hausformat View Helper Collection",
    "homepage": "https://hausformat.com",
    "require": {
        "typo3/cms-core": "^14",
        "ext-dom": "*",
        "hausformat/scss": "^3.0",
        "hausformat/hf-lib": "^2.0"
    },
    "require-dev": {
        "typo3/testing-framework": "^9",
        "phpunit/phpunit": "^11.2.5 || ^12.1.2 || ^13.0.2",
        "phpstan/phpstan": "^2",
        "typo3/coding-standards": "^0.8.0"
    },
    "autoload": {
        "psr-4": {
            "Hausformat\\ViewHelpers\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hausformat\\ViewHelpers\\Tests\\": "Tests"
        }
    },
    "license": [
        "All Rights Reserved"
    ],
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "hf_view_helpers",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "docs": [
            "@docs:build",
            "@docs:open"
        ],
        "docs:build": "bash ./Build/Scripts/runTests.sh -s docsGenerate",
        "docs:open": "open .Build/docs/index.html",
        "test:functional": "bash ./Build/Scripts/runTests.sh -s functional",
        "phpstan": ".Build/bin/phpstan analyse -c ./phpstan.neon --memory-limit 10G",
        "ci:phpstan": ".Build/bin/phpstan analyse --error-format=gitlab --no-progress -c ./phpstan.neon > gl-code-quality-report.json",
        "ci:test": [
            "@ci:test:functional",
            "@ci:test:phpunit"
        ],
        "ci:test:functional": "/bin/bash Build/Scripts/runTests.sh -s functional -- --log-junit functional-report.xml",
        "ci:test:phpunit": ".Build/bin/phpunit -c Build/phpunit/UnitTests.xml --log-junit phpunit-report.xml"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://gitlab.nyx.hausformat.net/api/v4/group/ext.hausformat/-/packages/composer/"
        }
    ],
    "keywords": [
        "TYPO3 CMS"
    ]
}
